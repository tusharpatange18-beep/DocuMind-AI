# Copy this file to ".env" (in the project root) and fill in your values.
# Never commit the real .env file.

# Required: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: main Gemini model, and backups tried when it is out of quota or busy
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_FALLBACK_MODELS=models/gemini-3-flash-preview,models/gemini-flash-lite-latest

# Optional: local embedding model used for search
EMBED_MODEL_NAME=all-MiniLM-L6-v2

# Optional: only for hosted deployments with Supabase Storage
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=rag-chatbot
